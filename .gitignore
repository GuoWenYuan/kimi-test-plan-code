# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/pi-service/node_modules
pi-service/.pi-subagents/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地数据（含模型 ApiKey，切勿提交）
/data/
# pi-service 本地运行数据（auth.json / models.json / sessions，切勿提交）
/pi-service/data/

# Python 转换管线虚拟环境
/tools/.venv/
__pycache__/

# SQLite 数据库文件（可能在项目外任意 DATABASE_PATH，保险起见全局忽略）
*.db
*.db-wal
*.db-shm
*.migrated.bak

# 运行日志
server.log

# image-mcp 生成的图片（默认保存目录）
/generated-images/

# 8300 分享通道目录（docker compose share 服务托管，内容为临时分发物）
/share/

# frp 真实配置（frps.toml 含 auth token，切勿提交；frpc.toml 为各机器本地配置。示例 frpc.example.toml 保留跟踪）
/frp/frps.toml
/frp/frpc.toml
